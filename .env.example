# Deployment configuration template. Copy to .env; never ship this file in an image.
KE_ENV=dev
KE_AUTH__ENABLED=false

# Host address the gateway publishes on. IPv4 only. Loopback keeps the stack on
# this machine; any other value exposes it, unauthenticated, to the network, and
# is refused outside KE_ENV=dev until auth-audit lands (PS-2.14).
KE_BIND_ADDRESS=127.0.0.1

# Published host ports, on KE_BIND_ADDRESS (47100-47199 reserved; next free
# number for each new one). Only the gateway publishes.
KE_API_PORT=47100
KE_PHOENIX_PORT=47101

# Not published: the gateway's listen ports inside the container, the api's
# own listen port, and Phoenix's. The gateway's model forward is reachable on
# the backend network only (KE_GATEWAY_MODEL_LISTEN).
KE_GATEWAY_API_LISTEN=8100
KE_GATEWAY_PHOENIX_LISTEN=8101
KE_GATEWAY_MODEL_LISTEN=8102
KE_API_LISTEN=8080
PHOENIX_PORT=6006

# Phoenix: the engine reaches it inside compose at the service name (phoenix);
# the browser UI is at http://localhost:<KE_PHOENIX_PORT> (via the gateway).
# Changing the collector endpoint to a non-local host is refused at startup.
# defaults.yaml keeps tracing off.
HARNESS_TRACING=otlp

# The model host as host:port, set per deployment. This deployment's host is
# aria-gb10-2 (OpenAI-compatible); the port and scheme are chosen in .env.
KE_MODEL_UPSTREAM=
KE_EGRESS_ALLOWLIST=

# Secrets: placeholders only. Any value starting with "changeme" is refused outside dev.
KE_STORES__POSTGRES__PASSWORD=changeme-stores-postgres-password
KE_STORES__NEO4J__PASSWORD=changeme-stores-neo4j-password
