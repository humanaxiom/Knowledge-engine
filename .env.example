# Deployment configuration template. Copy to .env; never ship this file in an image.
KE_ENV=dev
KE_AUTH__ENABLED=false

# Published host ports (47100-47199 reserved; next free number for each new one).
KE_PHOENIX_PORT=47101

# Phoenix: the engine reaches it inside compose at the service name (phoenix);
# the browser UI is at http://localhost:<KE_PHOENIX_PORT> (loopback only).
# Changing the collector endpoint to a non-local host is refused at startup.
# defaults.yaml keeps tracing off.
HARNESS_TRACING=otlp

# The model host as host:port, set per deployment. This deployment's host is
# aria-gb10-2 (OpenAI-compatible); the port and scheme are chosen in .env.
KE_MODEL_UPSTREAM=
KE_EGRESS_ALLOWLIST=

# Secrets: placeholders only. Any value starting with "changeme" is refused outside dev.
KE_STORES__POSTGRES__PASSWORD=changeme-stores-postgres-password
KE_STORES__NEO4J__PASSWORD=changeme-stores-neo4j-password
